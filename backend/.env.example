# Copy to backend/.env and fill in. Never commit .env.

# App
APP_ENV=development
LOG_LEVEL=INFO
READ_ONLY=false
CORS_ORIGINS=http://localhost:5173

# Database (local Compose). Behind a transaction pooler set DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/medcite
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:dev@localhost:5432/medcite
DB_STATEMENT_CACHE_SIZE=100
# Where the pgvector extension lives: public locally, extensions on Supabase.
DB_VECTOR_SCHEMA=public

# Redis
REDIS_URL=redis://localhost:6379/0

# NCBI E-utilities (https://account.ncbi.nlm.nih.gov/settings/ -> API Key Management)
NCBI_API_KEY=
NCBI_TOOL=medcite
NCBI_EMAIL=you@example.com
NCBI_MAX_RPS=9

# LLM: Groq free plan (https://console.groq.com/keys)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PLANNER=openai/gpt-oss-20b
LLM_MODEL_GENERATOR=openai/gpt-oss-120b
LLM_MODEL_JUDGE=qwen/qwen3.8-27b
LLM_REASONING_PLANNER=low
LLM_REASONING_GENERATOR=medium
LLM_REASONING_JUDGE=low
# Optional USD per million tokens [input, output]; leave empty on the free plan.
# LLM_PRICES={"openai/gpt-oss-120b": [0.15, 0.60], "openai/gpt-oss-20b": [0.075, 0.30]}

# MedCPT
EMBED_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
EMBED_ARTICLE_MODEL=ncbi/MedCPT-Article-Encoder
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
HF_HOME=./.models

# Auth (dev mode is only allowed with APP_ENV=development)
AUTH_MODE=dev
AUTH_DEV_SIGNING_KEY=
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# Limits
USER_DAILY_COST_CAP_USD=2.00
DISCOVERY_MAX_ARTICLES=50

# Observability (optional locally)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
