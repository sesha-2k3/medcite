# Copy to backend/.env and fill in. Never commit .env.

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Database (local Compose). Behind a transaction pooler set DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/medcite
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:dev@localhost:5432/medcite
DB_STATEMENT_CACHE_SIZE=100

# Redis
REDIS_URL=redis://localhost:6379/0

# NCBI E-utilities (https://account.ncbi.nlm.nih.gov/settings/ -> API Key Management)
NCBI_API_KEY=
NCBI_TOOL=medcite
NCBI_EMAIL=you@example.com
NCBI_MAX_RPS=9

# LLM: Groq free plan (https://console.groq.com/keys)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_PLANNER=openai/gpt-oss-20b
LLM_MODEL_GENERATOR=openai/gpt-oss-120b
LLM_MODEL_JUDGE=qwen/qwen3.8-27b
LLM_REASONING_PLANNER=low
LLM_REASONING_GENERATOR=medium
LLM_REASONING_JUDGE=none
# Optional USD per million tokens [input, output]; leave empty on the free plan.
# LLM_PRICES={"openai/gpt-oss-120b": [0.15, 0.60], "openai/gpt-oss-20b": [0.075, 0.30]}

# MedCPT
EMBED_QUERY_MODEL=ncbi/MedCPT-Query-Encoder
EMBED_ARTICLE_MODEL=ncbi/MedCPT-Article-Encoder
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
HF_HOME=./.models

# Generation (sized for Groq's free plan; raise on a paid plan)
GENERATION_CONTEXT_TOKENS=3400
PASSAGE_MAX_CHARS=1400
GENERATION_MAX_TOKENS=2500
JUDGE_MAX_TOKENS=2000

# Pipeline (calibrate the relevance settings in M10)
TIER_RETMAX=20
ENOUGH_RELEVANT_PASSAGES=5
RELEVANCE_THRESHOLD=0.0
SSE_HEARTBEAT_S=15

# Auth (dev mode is only allowed with APP_ENV=development)
AUTH_MODE=dev
# Generate with: make dev-key
AUTH_DEV_SIGNING_KEY=
AUTH_JWKS_CACHE_TTL_S=3600
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# Limits
USER_DAILY_COST_CAP_USD=2.00
DISCOVERY_MAX_ARTICLES=50

# Observability (optional locally)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://us.cloud.langfuse.com"
SENTRY_DSN=

# relevance: best matches from each month of the window; pub_date: newest only
DISCOVERY_MAX_THEMES=8
DISCOVERY_ARTICLES_PER_THEME=6
DISCOVERY_SUMMARY_MAX_TOKENS=3000
NCBI_DISCOVERY_CACHE_TTL_S=3600